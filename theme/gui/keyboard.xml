<layout>
  <!--
    Material 3 Expressive / Caelestia keyboard for WayVR.
    Hover (tertiary) and press (highlight ring) colors are applied by WayVR's
    code; the palette maps them to a tonal container and the state layer.
  -->
  <theme>
    <var key="text_size" value="20" />
    <var key="r_panel" value="14" />
  </theme>

  <!-- Letter keys: pills on the panel surface -->
  <macro name="keycap_rect"
    margin="3" width="100%" overflow="hidden" box_sizing="border_box"
    border_color="background_variant" border="2" round="100%" color="background_variant"
    align_items="center" justify_content="center" />

  <!-- Modifier / special keys: primary-tinted tonal pills -->
  <macro name="modcap_rect"
    margin="3" width="100%" overflow="hidden" box_sizing="border_box"
    border_color="primary(opacity-0.0)" border="2" round="100%" color="primary(opacity-0.16)"
    align_items="center" justify_content="center" />

  <macro name="keycap_div"
    width="${width}" height="${height}" min_width="${width}" min_height="${height}" max_width="${width}" max_height="${height}"
  />

  <macro name="chip"
    height="44" min_width="44" padding_left="10" padding_right="10" gap="6" round="100%"
    border="0" color="background_variant" border_color="background_variant"
    hover_color="tertiary" hover_border_color="tertiary"
    sticky_color="primary" sticky_border_color="primary" />

  <template name="VerticalSeparator">
    <rectangle width="2" height="24" round="100%" color="outline" />
  </template>

  <!-- The keyboard is built from the xkb keymap. These templates style the keycaps. -->

  <template name="KeySpecial">
    <div macro="keycap_div">
      <rectangle id="${id}" macro="modcap_rect">
        <sprite color="primary" width="24" height="24" src_builtin="keyboard/${text}.svg" />
      </rectangle>
    </div>
  </template>

  <template name="KeyLetter">
    <div macro="keycap_div">
      <rectangle id="${id}" macro="keycap_rect">
        <label text="${text}" size="~text_size" color="on_background" />
      </rectangle>
    </div>
  </template>

  <template name="KeyLetterAltGr">
    <div macro="keycap_div">
      <rectangle id="${id}" macro="keycap_rect" gap="3">
        <label text="${text}" size="~text_size" color="on_background" />
        <label color="on_background_variant" text="${text_altgr}" size="~text_size" />
      </rectangle>
    </div>
  </template>

  <template name="KeySymbol">
    <div macro="keycap_div">
      <rectangle id="${id}" macro="keycap_rect" gap="3">
        <label color="on_background_variant" text="${text_shift}" size="16" />
        <label text="${text}" size="~text_size" color="on_background" />
      </rectangle>
    </div>
  </template>

  <template name="KeySymbolAltGr">
    <div macro="keycap_div">
      <rectangle id="${id}" macro="keycap_rect" flex_direction="row" flex_wrap="wrap" padding="4">
        <div width="50%" height="50%" align_items="center" justify_content="center">
          <label color="on_background_variant" text="${text_shift}" size="16" />
        </div>
        <div width="50%" height="50%" align_items="center" justify_content="center" />
        <div width="50%" height="50%" align_items="center" justify_content="center">
          <label text="${text}" size="~text_size" color="on_background" />
        </div>
        <div width="50%" height="50%" align_items="center" justify_content="center">
          <label color="on_background_variant" text="${text_altgr}" size="16" />
        </div>
      </rectangle>
    </div>
  </template>

  <template name="KeyOther">
    <div macro="keycap_div">
      <rectangle id="${id}" macro="modcap_rect">
        <label text="${text}" size="15" weight="bold" color="primary" />
      </rectangle>
    </div>
  </template>

  <blueprint name="menu_app">
    <context_menu >
      <cell translation="BAR.TOGGLE_VISIBILITY" _press="::OverlayToggle ${name}" />
      <cell translation="BAR.RESET_POSITION" _press="::OverlayReset ${name}" />
      <cell translation="BAR.CLOSE_APP" _press="::WvrOverlayTermProcess ${name}" />
      <cell translation="BAR.FORCE_CLOSE_APP" _press="::WvrOverlayKillProcess ${name}" />
    </context_menu>
  </blueprint>

  <template name="App">
    <Button macro="chip" id="overlay_${idx}" tooltip_str="${name}" _context_name="${name}" _press_left="::ContextMenuOpen menu_app" _press_right="::OverlayToggle ${name}">
      <sprite width="26" height="26" src_ext="${icon}" parent_color="ignore" />
    </Button>
  </template>

  <blueprint name="menu_screen">
    <context_menu >
      <cell translation="BAR.TOGGLE_VISIBILITY" _press="::OverlayToggle ${name}" />
      <cell translation="BAR.RESET_POSITION" _press="::OverlayReset ${name}" />
    </context_menu>
  </blueprint>

  <template name="Screen">
    <Button macro="chip" id="overlay_${idx}" tooltip_str="${name}" _context_name="${name}" _press_left="::ContextMenuOpen menu_screen" _press_right="::OverlayToggle ${name}" padding_right="14">
      <sprite width="22" height="22" src_builtin="edit/screen.svg" />
      <label text="${display}" size="16" weight="bold" />
    </Button>
  </template>

  <blueprint name="menu_panel">
    <context_menu >
      <cell translation="BAR.TOGGLE_VISIBILITY" _press="::OverlayToggle ${name}" />
      <cell translation="BAR.RESET_POSITION" _press="::OverlayReset ${name}" />
      <cell translation="BAR.RELOAD_FROM_DISK" _press="::CustomOverlayReload ${name}" />
    </context_menu>
  </blueprint>

  <template name="Panel">
    <Button macro="chip" id="overlay_${idx}" tooltip_str="${name}" _context_name="${name}" _press_left="::ContextMenuOpen menu_panel" _press_right="::OverlayToggle ${name}">
      <sprite width="24" height="24" src="${icon}" />
    </Button>
  </template>

  <blueprint name="menu_mirror">
    <context_menu >
      <cell translation="BAR.TOGGLE_VISIBILITY" _press="::OverlayToggle ${name}" />
      <cell translation="BAR.RESET_POSITION" _press="::OverlayReset ${name}" />
      <cell translation="BAR.CLOSE_OVERLAY" _press="::OverlayDrop ${name}" />
    </context_menu>
  </blueprint>

  <template name="Mirror">
    <Button macro="chip" id="overlay_${idx}" tooltip_str="${name}" _context_name="${name}" _press_left="::ContextMenuOpen menu_mirror" _press_right="::OverlayToggle ${name}" padding_right="14">
      <sprite width="22" height="22" src_builtin="edit/mirror.svg" />
      <label text="${display}" size="16" weight="bold" />
    </Button>
  </template>

  <template name="Passthru">
    <Button macro="chip" id="overlay_${idx}" tooltip_str="${name}" _context_name="${name}" _press_left="::ContextMenuOpen menu_mirror" _press_right="::OverlayToggle ${name}" padding_right="14">
      <sprite width="22" height="22" src_builtin="icons/landscape.svg" />
      <label text="${display}" size="16" weight="bold" />
    </Button>
  </template>

  <blueprint name="menu_handsfree">
    <context_menu >
      <cell translation="BAR.HANDSFREE.NONE" _press="::HandsfreeMode None" _press2="::ContextMenuClose" />
      <cell translation="BAR.HANDSFREE.HMD" _press="::HandsfreeMode Hmd" _press2="::ContextMenuClose" skip="${openvr}" />
      <cell translation="BAR.HANDSFREE.HMD_ONLY" _press="::HandsfreeMode HmdOnly" _press2="::ContextMenuClose" />
      <cell translation="BAR.HANDSFREE.EYE_TRACKING" _press="::HandsfreeMode EyeTracking" _press2="::ContextMenuClose" skip="${openvr}" />
      <cell translation="BAR.HANDSFREE.EYE_ONLY" _press="::HandsfreeMode EyeTrackingOnly" _press2="::ContextMenuClose" />
    </context_menu>
  </blueprint>

  <blueprint name="menu_burger">
    <context_menu >
      <cell translation="BAR.EDIT_MODE_TOGGLE" _press="::EditToggle" _press2="::ContextMenuClose" />
      <cell translation="BAR.HANDSFREE.TITLE" _press="::ContextMenuOpen menu_handsfree" />
      <cell translation="BAR.ADD_MIRROR" _press="::NewMirror" skip="${not_wayland}" />
      <cell translation="BAR.ADD_PASSTHRU" _press="::NewPassthru" skip="${not_passthru}" />
      <cell translation="BAR.ADD_NEW_SET" _press="::AddSet" />
      <cell translation="BAR.DELETE_CURRENT_SET" _press="::DeleteSet" />
    </context_menu>
  </blueprint>

  <template name="Set">
    <Button macro="chip" id="set_${idx}" _press="::SetSwitch ${idx}" tooltip="WATCH.SWITCH_TO_SET" tooltip_side="bottom" padding_right="14">
      <sprite width="20" height="20" src_builtin="watch/set2.svg" />
      <label text="${display}" size="16" weight="bold" />
    </Button>
  </template>

  <template name="Clock">
    <div flex_direction="row" gap="8" align_items="center" padding_left="4" padding_right="8">
      <label text="23:59" _source="clock" _display="time" size="20" weight="bold" color="primary" />
      <label text="Thu" _source="clock" _display="dow_short" size="15" color="on_background_variant" />
    </div>
  </template>

  <elements>
    <div flex_direction="column" align_items="center" interactable="0">

      <!-- Bar: a drawer tab melting into the keyboard's top edge -->
      <div flex_direction="row" align_items="flex_end" margin_bottom="-1" interactable="0">
        <sprite width="24" height="24" src="m3/fillet-left.svg" margin_right="-1" color="background_contrast" />
        <div flex_direction="column">
          <rectangle position="absolute" width="100%" height="30" margin_top="30" color="background_contrast" />
          <rectangle color="background_contrast" round="100%" height="60" padding_left="8" padding_right="8" align_items="center" gap="10">
            <Button macro="chip" id="btn_dashboard" _press="::DashToggle" color="primary" border_color="primary" padding_left="12" padding_right="12">
              <sprite width="26" height="26" src_builtin="watch/wayvr_dashboard_mono.svg" />
            </Button>
            <VerticalSeparator />
            <div id="panels_root" gap="6" align_items="center">
            </div>
            <div id="apps_root" gap="6" align_items="center" skip="${openvr}">
            </div>
            <VerticalSeparator />
            <div id="tray_root" flex_direction="row" gap="6" align_items="center">
              <div id="sets_root" flex_direction="row" gap="6" align_items="center">
              </div>
              <Button macro="chip" _press="::ContextMenuOpen menu_burger">
                <sprite width="24" height="24" src_builtin="keyboard/burger.svg" />
              </Button>
              <div id="clock_root">
                <Clock />
              </div>
            </div>
          </rectangle>
        </div>
        <sprite width="24" height="24" src="m3/fillet-right.svg" margin_left="-1" color="background_contrast" />
      </div>

      <rectangle id="keyboard_root" color="background_contrast" round="~r_panel" flex_direction="column" padding="12">
      </rectangle>
    </div>
  </elements>

</layout>
