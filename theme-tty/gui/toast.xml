<layout>
  <!--
    TTY for WayVR: KiiteShell's TTY notification box, its title set into the
    top edge (see watch.xml).

    WayVR fills the title/body labels by id, and the ids changed between
    versions: 26.8.0 uses toast_title/toast_body, later builds use
    label_title/label_body. Both pairs are here; install.sh keeps the pair
    the installed binary uses.

    Later builds also scale `rect_separator` as the toast's countdown and tint
    `rect`'s border with tertiary while it's paused. 26.8.0 leaves both static.
  -->
  <elements>
    <!-- Provides a larger hitbox for eye gaze -->
    <div padding="60" interactable="0">
      <div flex_direction="column_reverse">
        <rectangle id="rect"
          max_width="520" min_width="320"
          padding="16" padding_top="22" flex_direction="column" gap="8"
          color="background_contrast" border_color="#3f4d49" border="1" round="0">

          <div flex_direction="column" id="div_title">
            <label wrap="1" id="toast_title" color="#e7eeec" weight="bold" size="20" />
            <label wrap="1" id="label_title" color="#e7eeec" weight="bold" size="20" />
          </div>

          <div flex_direction="column">
            <label id="toast_body" color="on_background_variant" wrap="1" size="17" />
            <label id="label_body" color="on_background_variant" wrap="1" size="17" />
          </div>

          <!-- Countdown (animated on later builds): one solid run over the ░ track -->
          <rectangle width="100%" height="6" round="0" color="#16211f" margin_top="4">
            <rectangle id="rect_separator" width="100%" height="6" round="0" color="primary" />
          </rectangle>
        </rectangle>
        <!-- a notification opens, so its title has a cursor (steady: WayVR can't blink it) -->
        <div flex_direction="row" height="24" padding_left="14" margin_bottom="-12" interactable="0">
          <rectangle color="background_contrast" padding_left="8" padding_right="8" align_items="center" gap="1">
            <label text="notify" color="primary" size="16" />
            <label text="█" color="primary" size="16" />
          </rectangle>
        </div>
      </div>
    </div>
  </elements>
</layout>
