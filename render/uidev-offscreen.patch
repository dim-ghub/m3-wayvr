index 0000000..35a4adf
--- /dev/null
+++ b/uidev/src/offscreen.rs
@@ -0,0 +1,83 @@
+// Renders the current layout into an offscreen image and saves it as a
+// transparent PNG (RENDER_PNG=path, optional RENDER_SCALE, default 2).
+
+use std::sync::Arc;
+
+use vulkano::{
+	buffer::{Buffer, BufferCreateInfo, BufferUsage},
+	command_buffer::{CommandBufferUsage, CopyImageToBufferInfo},
+	format::Format,
+	image::{ImageUsage, view::ImageView},
+	memory::allocator::{AllocationCreateInfo, MemoryTypeFilter},
+};
+use wgui::{
+	gfx::{WGfx, cmd::WGfxClearMode},
+	layout::Layout,
+	renderer_vk,
+};
+
+pub fn render_png(
+	gfx: &Arc<WGfx>,
+	shared: &mut renderer_vk::context::SharedContext,
+	layout: &mut Layout,
+	scale: f32,
+	path: &str,
+) -> anyhow::Result<()> {
+	let size = layout.content_size;
+	let (w, h) = ((size.x * scale).ceil() as u32, (size.y * scale).ceil() as u32);
+	anyhow::ensure!(w > 0 && h > 0, "layout has no content");
+
+	let mut ctx = renderer_vk::context::Context::new(shared, scale)?;
+	ctx.update_viewport(shared, [w, h], scale)?;
+
+	let image = gfx.new_image(w, h, gfx.surface_format, ImageUsage::COLOR_ATTACHMENT | ImageUsage::TRANSFER_SRC)?;
+	let readback = Buffer::new_slice::<u8>(
+		gfx.memory_allocator.clone(),
+		BufferCreateInfo {
+			usage: BufferUsage::TRANSFER_DST,
+			..Default::default()
+		},
+		AllocationCreateInfo {
+			memory_type_filter: MemoryTypeFilter::PREFER_HOST | MemoryTypeFilter::HOST_RANDOM_ACCESS,
+			..Default::default()
+		},
+		u64::from(w * h * 4),
+	)?;
+
+	let mut cmd = gfx.create_gfx_command_buffer(CommandBufferUsage::OneTimeSubmit)?;
+	cmd.begin_rendering(ImageView::new_default(image.clone())?, WGfxClearMode::Clear([0.0, 0.0, 0.0, 0.0]))?;
+	{
+		let globals = layout.state.globals.clone();
+		let mut globals = globals.get();
+		let primitives = {
+			let mut params = wgui::drawing::DrawParams {
+				globals: &mut globals,
+				layout,
+				debug_draw: false,
+				timestep_alpha: 1.0,
+			};
+			wgui::drawing::draw(&mut params)?
+		};
+		ctx.draw(&globals.font_system, shared, &mut cmd, &primitives)?;
+	}
+	cmd.end_rendering()?;
+	cmd.command_buffer
+		.copy_image_to_buffer(CopyImageToBufferInfo::image_buffer(image, readback.clone()))?;
+	cmd.build_and_execute_now()?;
+
+	let bgra = matches!(
+		gfx.surface_format,
+		Format::B8G8R8A8_SRGB | Format::B8G8R8A8_UNORM
+	);
+	let data = readback.read()?;
+	let mut rgba = Vec::with_capacity(data.len());
+	for px in data.chunks_exact(4) {
+		let (r, g, b, a) = if bgra { (px[2], px[1], px[0], px[3]) } else { (px[0], px[1], px[2], px[3]) };
+		// Blending onto a transparent clear leaves color premultiplied by alpha
+		let un = |c: u8| if a == 0 { 0 } else { ((u32::from(c) * 255 + u32::from(a) / 2) / u32::from(a)).min(255) as u8 };
+		rgba.extend_from_slice(&[un(r), un(g), un(b), a]);
+	}
+	image::save_buffer(path, &rgba, w, h, image::ColorType::Rgba8)?;
+	log::info!("wrote {path} ({w}x{h}, {:?})", gfx.surface_format);
+	Ok(())
+}
